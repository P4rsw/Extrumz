<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns all theming; this just gives an edge-to-edge,
      action-bar-free window.

      windowBackground is the app's own base rather than pure black: this is
      the colour the window wears between the launcher's tap and the first
      Compose frame, and black against #0B0B0F content read as a dark flash
      that then changed shade. They are the same colour now.
    -->
    <style name="Theme.Extrumz" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/extrumz_base</item>
    </style>
</resources>
