<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Extrumz" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/extrumz_base</item>
    </style>

    <!--
      The splash the window shows before Compose runs.

      The overlay in ExtrumzSplash cannot cover the first frames: the window is
      drawn, and stays drawn, until the first Compose frame replaces it, and no
      composable exists before that. Whoever held the phone saw the theme's
      windowBackground, which was pure black in the night theme until this
      change, so a dark-mode launch was a black screen that then jumped to the
      app.

      This theme is that window, and the platform holds it for as long as
      setKeepOnScreenCondition says. Same colour as the app's base, so the
      handover to the first frame has nothing to flash.
    -->
    <style name="Theme.Extrumz.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/extrumz_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_white</item>
        <item name="postSplashScreenTheme">@style/Theme.Extrumz</item>
    </style>
</resources>
